# DevKit AI Configuration Template
# Copy this file to .env in your project and configure your desired AI provider.

# 1. Google Gemini (Default - Fast & High Free Quota)
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Anthropic Claude (Alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Provider Settings
# DEVKIT_AI_PROVIDER=gemini
# DEVKIT_AI_MODEL=gemini-flash-lite-latest
# DEVKIT_AI_BASE_URL=
# DEVKIT_MAX_FILE_SIZE_KB=512
