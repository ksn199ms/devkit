# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force specific text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep binary files untouched
*.png binary
*.jpg binary
*.ico binary
